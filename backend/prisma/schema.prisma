generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder: se reemplaza por los modelos reales al implementar
// el primer change de OpenSpec (ver openspec/changes/secretaria-academica).
model SystemInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
