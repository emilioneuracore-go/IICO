generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity/access-control (openspec/changes/secretaria-academica)
// ---------------------------------------------------------------------------

model Usuario {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  roles        UsuarioRol[]
  auditorias   RegistroAuditoria[]
  areasDictadas MateriaArea[]
  actasEvaluadas ActaDocente[]
  planesAcompanamiento PlanAcompanamiento[]
}

model Rol {
  id        String        @id @default(uuid())
  nombre    String        @unique
  usuarios  UsuarioRol[]
  permisos  RolPermiso[]
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
}

model Permiso {
  id     String       @id @default(uuid())
  nombre String       @unique
  roles  RolPermiso[]
}

model RolPermiso {
  rolId     String
  permisoId String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model RegistroAuditoria {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  accion    String
  entidad   String
  entidadId String
  fecha     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// secretaria-academica/materias
// ---------------------------------------------------------------------------

enum DuracionMateria {
  ANUAL
  BIANUAL
  TRIANUAL
}

enum ModalidadAcreditacion {
  POR_TRAMO
  AL_FINAL_DEL_CICLO
}

enum EscalaCalificacion {
  CUALITATIVA
  CUANTITATIVA
}

model Materia {
  id                    String                 @id @default(uuid())
  nombre                String
  duracion              DuracionMateria         @default(ANUAL)
  modalidadAcreditacion ModalidadAcreditacion?
  escalaEtapaIntermedia EscalaCalificacion?
  escalaCierre          EscalaCalificacion?
  areas                 MateriaArea[]
  vinculosComoA         MateriaVinculo[]        @relation("MateriaVinculoA")
  vinculosComoB         MateriaVinculo[]        @relation("MateriaVinculoB")
  actas                 Acta[]
  cursadas              CursadaMateria[]
  materiasAdeudadas     MateriaAdeudada[]
}

model MateriaArea {
  id               String   @id @default(uuid())
  materiaId        String
  nombre           String
  docenteUsuarioId String?
  materia          Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  docenteUsuario   Usuario? @relation(fields: [docenteUsuarioId], references: [id])

  @@unique([materiaId, nombre])
}

// Proyecto Integrado: vínculo entre dos materias independientes, cada una
// conserva su propia acreditación (ver design.md - Proyecto Integrado como
// vínculo entre materias, no como fusión).
model MateriaVinculo {
  id         String  @id @default(uuid())
  materiaAId String
  materiaBId String
  materiaA   Materia @relation("MateriaVinculoA", fields: [materiaAId], references: [id], onDelete: Cascade)
  materiaB   Materia @relation("MateriaVinculoB", fields: [materiaBId], references: [id], onDelete: Cascade)

  @@unique([materiaAId, materiaBId])
}

// ---------------------------------------------------------------------------
// secretaria-academica/legajos-alumnos
// ---------------------------------------------------------------------------

enum VinculoResponsable {
  MADRE
  PADRE
  TUTOR
}

model Alumno {
  id              String               @id @default(uuid())
  nombre          String
  apellido        String
  documento       String               @unique
  fechaNacimiento DateTime
  domicilio       String?
  telefono        String?
  activo          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  responsables    AlumnoResponsable[]
  historial       LegajoHistorialCambio[]
  inscripcionesLibroMatriz InscripcionLibroMatriz[]
  actas           ActaAlumno[]
  cursadas        CursadaMateria[]
  materiasAdeudadas MateriaAdeudada[]
  pases           PaseEstudiante[]
}

model Responsable {
  id       String              @id @default(uuid())
  nombre   String
  apellido String
  telefono String?
  email    String?
  alumnos  AlumnoResponsable[]
}

model AlumnoResponsable {
  alumnoId      String
  responsableId String
  vinculo       VinculoResponsable
  alumno        Alumno      @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  responsable   Responsable @relation(fields: [responsableId], references: [id], onDelete: Cascade)

  @@id([alumnoId, responsableId])
}

model LegajoHistorialCambio {
  id            String   @id @default(uuid())
  alumnoId      String
  usuarioId     String
  campo         String
  valorAnterior String?
  valorNuevo    String?
  fecha         DateTime @default(now())
  alumno        Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// secretaria-academica/libro-matriz
// ---------------------------------------------------------------------------

model InscripcionLibroMatriz {
  id                  String   @id @default(uuid())
  libro               String
  anio                Int
  numeroCorrelativo   Int
  alumnoId            String
  activa              Boolean  @default(true)
  // Solo tiene valor "{alumnoId}:{anio}" mientras la inscripción está activa;
  // se pone en null al desactivarla. El índice único solo choca entre dos
  // inscripciones activas del mismo alumno en el mismo período (NULL no
  // colisiona en un índice único de PostgreSQL).
  claveUnicidadActiva String?  @unique
  createdAt           DateTime @default(now())
  alumno              Alumno   @relation(fields: [alumnoId], references: [id])

  @@unique([libro, anio, numeroCorrelativo])
}

// ---------------------------------------------------------------------------
// secretaria-academica/actas-examen
// ---------------------------------------------------------------------------

enum AlcanceActa {
  TRAMO
  CICLO_COMPLETO
}

enum EstadoActa {
  ABIERTA
  CERRADA
}

enum ResultadoActaAlumno {
  APROBADO
  DESAPROBADO
}

model LibroActas {
  id        String   @id @default(uuid())
  nombre    String
  anio      Int
  createdAt DateTime @default(now())
  actas     Acta[]

  @@unique([nombre, anio])
}

model Acta {
  id           String        @id @default(uuid())
  libroActasId String
  materiaId    String
  fecha        DateTime
  alcance      AlcanceActa
  // Año del ciclo evaluado (1..duración de la materia); solo tiene valor
  // cuando alcance = TRAMO. En CICLO_COMPLETO el acta evalúa todos los años.
  tramoAnio    Int?
  estado       EstadoActa    @default(ABIERTA)
  createdAt    DateTime      @default(now())
  cerradaAt    DateTime?
  libroActas   LibroActas    @relation(fields: [libroActasId], references: [id])
  materia      Materia       @relation(fields: [materiaId], references: [id])
  docentes     ActaDocente[]
  alumnos      ActaAlumno[]
  materiasAdeudadasOrigen MateriaAdeudada[]
}

model ActaDocente {
  actaId    String
  usuarioId String
  acta      Acta    @relation(fields: [actaId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@id([actaId, usuarioId])
}

model ActaAlumno {
  id        String               @id @default(uuid())
  actaId    String
  alumnoId  String
  nota      Int?
  resultado ResultadoActaAlumno?
  acta      Acta                 @relation(fields: [actaId], references: [id], onDelete: Cascade)
  alumno    Alumno               @relation(fields: [alumnoId], references: [id])

  @@unique([actaId, alumnoId])
}

// Registra que un alumno cursó un año determinado del ciclo de una materia
// plurianual. Es lo único que permite validar, para una materia "al final
// del ciclo", que el alumno cursó todos los años antes de admitir su acta
// de cierre (ver design.md - materias/spec.md, no existe otro módulo de
// cursada todavía).
model CursadaMateria {
  id        String   @id @default(uuid())
  alumnoId  String
  materiaId String
  anio      Int
  createdAt DateTime @default(now())
  alumno    Alumno   @relation(fields: [alumnoId], references: [id])
  materia   Materia  @relation(fields: [materiaId], references: [id])

  @@unique([alumnoId, materiaId, anio])
}

// ---------------------------------------------------------------------------
// secretaria-academica/materias-previas
// ---------------------------------------------------------------------------

enum EstadoMateriaAdeudada {
  ACTIVA
  ACREDITADA
}

model MateriaAdeudada {
  id                 String                 @id @default(uuid())
  alumnoId           String
  materiaId          String
  // Año del ciclo adeudado; solo tiene valor para materias plurianuales
  // "por tramo" (ver actas-examen.Acta.tramoAnio, del que se copia).
  tramoAnio          Int?
  estado             EstadoMateriaAdeudada  @default(ACTIVA)
  actaOrigenId        String
  createdAt          DateTime               @default(now())
  acreditadaAt       DateTime?
  alumno             Alumno                 @relation(fields: [alumnoId], references: [id])
  materia            Materia                @relation(fields: [materiaId], references: [id])
  actaOrigen         Acta                   @relation(fields: [actaOrigenId], references: [id])
  planAcompanamiento PlanAcompanamiento?
}

model PlanAcompanamiento {
  id                   String          @id @default(uuid())
  materiaAdeudadaId    String          @unique
  docenteResponsableId String
  modalidad            String
  createdAt            DateTime        @default(now())
  materiaAdeudada      MateriaAdeudada @relation(fields: [materiaAdeudadaId], references: [id], onDelete: Cascade)
  docenteResponsable   Usuario         @relation(fields: [docenteResponsableId], references: [id])
}

// Configuración de la normativa de acreditación (ej. tope de materias
// adeudadas) como tabla clave/valor editable, no como constante en código
// (ver design.md - Parametrización de reglas normativas).
model ConfiguracionAcreditacion {
  id        String   @id @default(uuid())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// secretaria-academica/pases-estudiantes
// ---------------------------------------------------------------------------

enum TipoPase {
  INGRESO
  EGRESO
}

enum EstadoPase {
  PENDIENTE
  EN_PROCESO
  COMPLETO
}

model PaseEstudiante {
  id                  String     @id @default(uuid())
  tipo                TipoPase
  alumnoId            String
  institucionOrigen   String?
  institucionDestino  String?
  documentacionOrigen String?
  documentacionPase   String?
  estado              EstadoPase @default(PENDIENTE)
  createdAt           DateTime   @default(now())
  completadoAt        DateTime?
  alumno              Alumno     @relation(fields: [alumnoId], references: [id])
}
